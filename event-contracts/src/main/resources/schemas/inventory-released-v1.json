{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.com/schemas/inventory-released-v1.json",
  "title": "InventoryReleasedEventV1",
  "type": "object",
  "required": [
    "orderId",
    "reservationId",
    "cancellationId",
    "quantity"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "reservationId": {
      "type": "string",
      "format": "uuid"
    },
    "cancellationId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
