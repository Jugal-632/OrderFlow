{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.com/schemas/order-placed-v1.json",
  "title": "OrderPlacedEventV1",
  "type": "object",
  "required": [
    "orderId",
    "customerId",
    "productId",
    "quantity"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
