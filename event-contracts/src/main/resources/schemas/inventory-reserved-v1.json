{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.com/schemas/inventory-reserved-v1.json",
  "title": "InventoryReservedEventV1",
  "type": "object",
  "required": [
    "orderId",
    "productId",
    "quantity",
    "reservationId"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "reservationId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": true
}
