{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.com/schemas/inventory-rejected-v1.json",
  "title": "InventoryRejectedEventV1",
  "type": "object",
  "required": [
    "orderId",
    "productId",
    "quantity",
    "reason",
    "availableQuantity"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "availableQuantity": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
